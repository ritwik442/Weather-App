# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLAlchemy database URL (SQLite by default; Postgres etc. supported)
DATABASE_URL=sqlite:///./weather.db

# Required by Nominatim's usage policy: identify this app (ideally with a contact)
NOMINATIM_USER_AGENT=weather-app/0.1 (contact@example.com)

# Optional: YouTube Data API v3 key. When absent, backend returns a search URL instead.
YOUTUBE_API_KEY=
